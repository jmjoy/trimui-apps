set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

project_dir := source_directory()
workspace_dir := project_dir / "../.."
scripts := workspace_dir / "scripts"

default: package

fmt:
    bash "{{ scripts }}/cargo.sh" fmt chinese_chess

test:
    bash "{{ scripts }}/cargo.sh" test chinese_chess

clippy:
    bash "{{ scripts }}/cargo.sh" clippy chinese_chess

check: fmt test clippy

build profile="release":
    bash "{{ scripts }}/cargo.sh" build chinese_chess "$@"

stage profile="release": (build profile)
    bash "{{ scripts }}/stage.sh" chinese_chess "$@"

package profile="release": (stage profile)
    bash "{{ scripts }}/package.sh" chinese_chess

# Install the archive without starting the application.
deploy profile="release": (package profile)
    bash "{{ scripts }}/deploy.sh" chinese_chess

# Deploy this module, then run its bounded device smoke test.
smoke-test profile="release": (deploy profile)
    bash "{{ scripts }}/smoke-test.sh" chinese_chess

run *args:
    bash "{{ scripts }}/run.sh" chinese_chess "$@"

input-test: smoke-test
    bash "{{ project_dir }}/scripts/input-test.sh"

clean:
    bash "{{ scripts }}/clean.sh" chinese_chess
