set shell := ["bash", "-euo", "pipefail", "-c"]

project_dir := source_directory()
workspace_dir := project_dir / "../.."
target_dir := workspace_dir / "target"
artifact_root := workspace_dir / "artifacts"
artifact_dir := artifact_root / "voxel-world"
stage_dir := artifact_root / "Ports/VoxelWorld"
toolchain_dir := workspace_dir / "toolchain"
binary_name := "trimui-voxel-world"
target_triple := "aarch64-unknown-linux-gnu.2.33"
device_dir := "/mnt/SDCARD/Ports/VoxelWorld"
marker_name := ".trimui-voxel-world"

default: package

fmt:
    cargo fmt --manifest-path "{{ workspace_dir }}/Cargo.toml" --all -- --check

test:
    cargo test --manifest-path "{{ workspace_dir }}/Cargo.toml" --locked -p {{ binary_name }}

clippy:
    cargo clippy --manifest-path "{{ workspace_dir }}/Cargo.toml" --locked -p {{ binary_name }} --all-targets -- -D warnings

check: fmt test clippy

build profile="release":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ profile }}" in
        release) cargo_args=(--release); output_profile=release ;;
        debug) cargo_args=(); output_profile=debug ;;
        *) printf 'profile must be release or debug\n' >&2; exit 2 ;;
    esac
    test -f "{{ toolchain_dir }}/pkgconfig/alsa.pc"
    test -f "{{ toolchain_dir }}/device-libs/libasound.so.2"
    PKG_CONFIG_ALLOW_CROSS=1 PKG_CONFIG_LIBDIR="{{ toolchain_dir }}/pkgconfig" \
        cargo zigbuild --locked --manifest-path "{{ workspace_dir }}/Cargo.toml" \
        --target-dir "{{ target_dir }}" --target "{{ target_triple }}" \
        -p {{ binary_name }} "${cargo_args[@]}"
    test -x "{{ target_dir }}/aarch64-unknown-linux-gnu/${output_profile}/{{ binary_name }}"

stage profile="release": (build profile)
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ profile }}" in release) output_profile=release ;; debug) output_profile=debug ;; *) exit 2 ;; esac
    mkdir -p "{{ artifact_dir }}"
    rm -rf "{{ stage_dir }}"
    mkdir -p "{{ stage_dir }}"
    cp "{{ target_dir }}/aarch64-unknown-linux-gnu/${output_profile}/{{ binary_name }}" "{{ stage_dir }}/"
    cp "{{ project_dir }}/config.json" "{{ project_dir }}/icon.png" "{{ stage_dir }}/"
    : > "{{ stage_dir }}/{{ marker_name }}"
    cat > "{{ stage_dir }}/launch.sh" <<'EOF'
    #!/bin/sh
    # MainUI yields its display before launching an app. The game brings CPU
    # cores online itself; this wrapper restores the recorded hotplug state
    # even after a crash or SIGKILL.
    cd "$(dirname "$0")" || exit 1
    export RUST_LOG="${RUST_LOG:-warn,trimui_voxel_world=info}"
    if [ -f voxel-world.log ] && [ "$(wc -c < voxel-world.log)" -gt 2000000 ]; then
        mv -f voxel-world.log voxel-world.log.old
    fi
    task_cpu_state=
    for task_cpu in /sys/devices/system/cpu/cpu[1-9]*; do
        [ -f "$task_cpu/online" ] && task_cpu_state="$task_cpu_state ${task_cpu##*/cpu}:$(cat "$task_cpu/online")"
    done
    restore_cpus() {
        for task_entry in $task_cpu_state; do
            echo "${task_entry#*:}" > "/sys/devices/system/cpu/cpu${task_entry%%:*}/online" 2>/dev/null
        done
    }
    task_app_pid=
    forward() { [ -n "$task_app_pid" ] && kill -TERM "$task_app_pid" 2>/dev/null; }
    trap forward HUP INT TERM
    ./trimui-voxel-world "$@" >> voxel-world.log 2>&1 &
    task_app_pid=$!
    while :; do
        wait "$task_app_pid"
        task_result=$?
        kill -0 "$task_app_pid" 2>/dev/null || break
    done
    restore_cpus
    exit "$task_result"
    EOF
    cat > "{{ stage_dir }}/test.sh" <<'EOF'
    #!/bin/sh
    # Reversible ADB test: pause MainUI, run under an independent watchdog,
    # then restore CPU hotplug state and resume MainUI on every exit path.
    cd "$(dirname "$0")" || exit 1
    task_ui_pids="$(pidof MainUI)"
    task_app_pid=
    task_cpu_state=
    for task_cpu in /sys/devices/system/cpu/cpu[1-9]*; do
        [ -f "$task_cpu/online" ] && task_cpu_state="$task_cpu_state ${task_cpu##*/cpu}:$(cat "$task_cpu/online")"
    done
    cleanup() {
        trap - EXIT HUP INT TERM
        if [ -n "$task_app_pid" ] && kill -0 "$task_app_pid" 2>/dev/null; then
            kill -TERM "$task_app_pid" 2>/dev/null
            wait "$task_app_pid" 2>/dev/null
        fi
        for task_entry in $task_cpu_state; do
            echo "${task_entry#*:}" > "/sys/devices/system/cpu/cpu${task_entry%%:*}/online" 2>/dev/null
        done
        for task_ui_pid in $task_ui_pids; do kill -CONT "$task_ui_pid" 2>/dev/null; done
        printf 'CPU online after exit: %s\n' "$(cat /sys/devices/system/cpu/online)"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' HUP TERM
    for task_ui_pid in $task_ui_pids; do kill -STOP "$task_ui_pid" || exit 1; done
    if [ "$#" -eq 0 ]; then set -- --seconds 15 --save-dir /tmp/voxel-world-smoke --config-dir /tmp/voxel-world-smoke-config; fi
    # The watchdog stays independent of the game's own --seconds limit.
    task_limit="${VOXEL_TEST_LIMIT:-30}"
    RUST_LOG="${RUST_LOG:-warn,trimui_voxel_world=info}" timeout -s TERM -k 5 "$task_limit" ./trimui-voxel-world "$@" &
    task_app_pid=$!
    wait "$task_app_pid"
    task_result=$?
    task_app_pid=
    printf 'Voxel World exit status: %s\n' "$task_result"
    exit "$task_result"
    EOF
    chmod 755 "{{ stage_dir }}/{{ binary_name }}" "{{ stage_dir }}/launch.sh" "{{ stage_dir }}/test.sh"
    cat > "{{ artifact_dir }}/input-events.cjs" <<'EOF'
    // Development-only Linux evdev events for the TRIMUI Player1 controller.
    // This writes test files; it neither opens input devices nor contacts the handheld.
    const fs = require('node:fs');
    const path = require('node:path');
    const dir = process.argv[2];
    if (!dir) throw new Error('Usage: node input-events.cjs OUTPUT_DIRECTORY');
    fs.rmSync(dir, { recursive: true, force: true });
    fs.mkdirSync(dir, { recursive: true });
    function event(type, code, value) {
      const bytes = Buffer.alloc(24); // aarch64 struct input_event
      bytes.writeUInt16LE(type, 16);
      bytes.writeUInt16LE(code, 18);
      bytes.writeInt32LE(value, 20);
      return bytes;
    }
    function write(name, ...events) {
      fs.writeFileSync(path.join(dir, name + '.bin'), Buffer.concat([...events, event(0, 0, 0)]));
    }
    const buttons = { b: 304, a: 305, y: 307, x: 308, l: 310, r: 311, select: 314, start: 315, menu: 316 };
    for (const [name, code] of Object.entries(buttons)) {
      write(name + '-press', event(1, code, 1));
      write(name + '-release', event(1, code, 0));
    }
    // Left stick ABS_X/Y, right stick ABS_RX/RY; L2/R2 are ABS_Z/ABS_RZ (0..255).
    const axes = {
      'move-forward': [1, -32767], 'move-back': [1, 32767],
      'move-left': [0, -32767], 'move-right': [0, 32767],
      'look-up': [4, -22000], 'look-down': [4, 22000],
      'look-left': [3, -22000], 'look-right': [3, 22000],
      place: [2, 255], dig: [5, 255],
    };
    for (const [name, [code, value]] of Object.entries(axes)) write(name, event(3, code, value));
    write('up', event(3, 17, -1));
    write('down', event(3, 17, 1));
    write('left', event(3, 16, -1));
    write('right', event(3, 16, 1));
    write('neutral', ...[0, 1, 2, 3, 4, 5, 16, 17].map((c) => event(3, c, 0)),
      ...Object.values(buttons).map((c) => event(1, c, 0)));
    write('exit-press', event(1, 314, 1), event(1, 315, 1));
    write('exit-release', event(1, 314, 0), event(1, 315, 0));
    EOF
    cat > "{{ artifact_dir }}/device-input-test.sh" <<'EOF'
    #!/bin/sh
    # Writes known controller events directly to event3; do not use physical buttons during this test.
    cd /mnt/SDCARD/Ports/VoxelWorld || exit 1
    task_input_dir=/tmp/voxel-world-input
    task_save=/tmp/voxel-world-input-save
    task_config=/tmp/voxel-world-input-config
    task_log=/tmp/voxel-world-input-run.log
    task_helper_log=/tmp/voxel-world-input-helper.log
    rm -rf "$task_save" "$task_config" /tmp/voxel-world-game-*.png
    : > "$task_log"
    : > "$task_helper_log"
    task_cpu_before="$(cat /sys/devices/system/cpu/online)"
    send() { cat "$task_input_dir/$1.bin" > /dev/input/event3; }
    wait_for_count() {
        task_attempt=0
        while [ "$(grep -c "$1" "$task_log")" -lt "$2" ]; do
            task_attempt=$((task_attempt + 1))
            if [ "$task_attempt" -gt 100 ]; then printf 'Timed out waiting for: %s (%s)\n' "$1" "$2"; return 1; fi
            sleep 0.1
        done
    }
    wait_for() { wait_for_count "$1" 1; }
    button() { send "$1-press"; sleep 0.12; send "$1-release"; sleep 0.2; }
    # Both taps land inside the 300 ms double-tap window.
    double() { send "$1-press"; sleep 0.05; send "$1-release"; sleep 0.07; send "$1-press"; sleep 0.05; send "$1-release"; sleep 0.25; }
    # Firmware input daemons resample the sticks, so axis values are re-sent.
    hold() {
        task_n=0
        while [ "$task_n" -lt "$2" ]; do send "$1"; sleep 0.03; task_n=$((task_n + 1)); done
        send neutral
        sleep 0.15
    }
    direction() { send "$1"; sleep 0.08; send neutral; sleep 0.2; }
    repeat() { task_k=0; while [ "$task_k" -lt "$2" ]; do direction "$1"; task_k=$((task_k + 1)); done; }
    shot() {
        kill -USR1 "$(pidof trimui-voxel-world)"
        wait_for "Screenshot: /tmp/voxel-world-game-$1.png"
    }
    (
        set -e
        trap 'send neutral; send exit-release' EXIT
        wait_for 'First frame: present completed'
        button a
        wait_for_count 'Game started' 1
        # Look at the ground in front of the player, not straight down.
        hold look-down 12
        hold dig 2
        wait_for 'Block broken'
        sleep 0.3
        hold place 2
        wait_for 'Block placed'
        button r
        wait_for 'Block selected: 2'
        button l
        wait_for 'Block selected: 1'
        button r
        wait_for_count 'Block selected: 2' 2
        button y
        wait_for 'Block picked: 1'
        button b
        wait_for 'Jump'
        double b
        wait_for 'Flight: true'
        hold move-forward 20
        hold look-right 15
        direction left
        wait_for 'Sneak toggle: true'
        direction right
        wait_for 'Sprint toggle: true'
        button x
        wait_for 'Palette opened'
        direction down
        direction right
        shot 1
        button a
        wait_for 'Palette pick:'
        wait_for_count 'Game started' 2
        # Place the picked block next to the player to show it in the world.
        hold place 2
        wait_for_count 'Block placed' 2
        # Slot 9 holds a glowstone lamp; light must spread from it.
        button l
        wait_for 'Block selected: 9 (glowstone)'
        # Aim a few blocks ahead so the lamp never overlaps the player.
        hold look-up 5
        hold place 2
        wait_for_count 'Block placed' 3
        button start
        wait_for 'Paused'
        repeat down 2
        button a
        direction right
        wait_for 'Settings: view=5'
        repeat down 8
        button a
        wait_for 'CPU cores: option=default'
        printf 'Device CPU online (default): %s\n' "$(cat /sys/devices/system/cpu/online)"
        button a
        wait_for 'CPU cores: option=all'
        printf 'Device CPU online (all): %s\n' "$(cat /sys/devices/system/cpu/online)"
        direction down
        button a
        wait_for 'debug_overlay=true'
        direction down
        button a
        button a
        wait_for 'Rebinding jump'
        shot 2
        button menu
        wait_for 'Binding: jump = menu'
        button b
        wait_for 'Config saved'
        button start
        wait_for_count 'Game started' 3
        double menu
        wait_for 'Flight: false'
        button start
        wait_for_count 'Paused' 2
        repeat down 2
        button a
        repeat down 10
        button a
        repeat down 10
        button a
        direction down
        button a
        wait_for 'Bindings reset to defaults'
        button start
        wait_for_count 'Game started' 4
        double b
        wait_for_count 'Flight: true' 2
        sleep 1.5
        shot 3
        send exit-press
        sleep 0.3
        send exit-release
    ) > "$task_helper_log" 2>&1 &
    task_helper_pid=$!
    trap 'kill "$task_helper_pid" 2>/dev/null; wait "$task_helper_pid" 2>/dev/null' EXIT
    trap 'exit 130' INT
    trap 'exit 143' HUP TERM
    VOXEL_TEST_LIMIT=60 sh ./test.sh --seconds 55 --save-dir "$task_save" --config-dir "$task_config" --seed 42 --capture /tmp/voxel-world-game.png --capture-after 999 > "$task_log" 2>&1
    task_app_status=$?
    wait "$task_helper_pid"
    task_helper_status=$?
    trap - EXIT
    cat "$task_log"
    cat "$task_helper_log"
    printf 'Config file: %s\n' "$(tr -d ' \n' < "$task_config/settings.json")"
    sleep 1
    sh ./test.sh --seconds 4 --save-dir "$task_save" --config-dir "$task_config" > /tmp/voxel-world-reload.log 2>&1
    cat /tmp/voxel-world-reload.log
    task_saved="$(grep 'World saved:' "$task_log" | tail -n 1 | sed 's/.*digest=//')"
    task_loaded="$(grep 'World loaded:' /tmp/voxel-world-reload.log | sed 's/.*digest=//')"
    printf 'Saved digest: %s; loaded digest: %s\n' "$task_saved" "$task_loaded"
    if [ "$task_app_status" -eq 0 ] && [ "$task_helper_status" -eq 0 ] &&
        grep -q '^Voxel World exit status: 0' "$task_log" &&
        grep -q 'Exit requested by SELECT + START' "$task_log" &&
        grep -q 'Audio: 48000 Hz, 2 channels, F32' "$task_log" &&
        grep -q 'Audio bank ready' "$task_log" &&
        grep -q 'Audio callback:' "$task_log" &&
        grep -q 'Device CPU online (default): 0-1' "$task_helper_log" &&
        grep -q 'Device CPU online (all): 0-3' "$task_helper_log" &&
        grep -q "CPU online after exit: $task_cpu_before" "$task_log" &&
        tr -d ' \n' < "$task_config/settings.json" | grep -q '"jump":"b"' &&
        tr -d ' \n' < "$task_config/settings.json" | grep -q '"view_distance":5' &&
        tr -d ' \n' < "$task_config/settings.json" | grep -q '"debug_overlay":true' &&
        grep -q 'Config loaded' /tmp/voxel-world-reload.log &&
        grep -q '^Voxel World exit status: 0' /tmp/voxel-world-reload.log &&
        [ -n "$task_saved" ] && [ "$task_saved" = "$task_loaded" ] &&
        test -f /tmp/voxel-world-game-1.png && test -f /tmp/voxel-world-game-3.png; then
        printf '%s\n' 'Input test: PASS'
    else
        printf '%s\n' 'Input test: FAIL'
        exit 1
    fi
    EOF
    cat > "{{ artifact_dir }}/device-exit-test.sh" <<'EOF'
    #!/bin/sh
    # Exit paths: error, TERM, KILL (test.sh and launch.sh), watchdog. Each must
    # restore the CPU hotplug state and leave MainUI running.
    cd /mnt/SDCARD/Ports/VoxelWorld || exit 1
    task_ui_pids="$(pidof MainUI)"
    test -n "$task_ui_pids" || { printf 'MainUI is not running\n'; exit 1; }
    task_cpu_before="$(cat /sys/devices/system/cpu/online)"
    task_save=/tmp/voxel-world-exit-save
    task_config=/tmp/voxel-world-exit-config
    rm -rf "$task_save" "$task_config"
    check() {
        task_now="$(cat /sys/devices/system/cpu/online)"
        if [ "$task_now" != "$task_cpu_before" ]; then printf '%s: CPU online %s, expected %s\n' "$1" "$task_now" "$task_cpu_before"; exit 1; fi
        for task_ui_pid in $task_ui_pids; do
            if grep -q '^State:.*T' "/proc/$task_ui_pid/status"; then printf '%s: MainUI still stopped\n' "$1"; exit 1; fi
        done
        printf '%s recovery: PASS\n' "$1"
    }
    wait_frame() {
        task_attempt=0
        until grep -q 'First frame: present completed' "$1"; do
            task_attempt=$((task_attempt + 1))
            [ "$task_attempt" -lt 100 ] || exit 1
            sleep 0.1
        done
        sleep 1
    }
    sh ./test.sh --seconds 1 --controller /dev/input/missing-voxel-test --save-dir "$task_save" --config-dir "$task_config" > /tmp/voxel-world-error.log 2>&1
    cat /tmp/voxel-world-error.log
    grep -q '^Voxel World exit status: 1' /tmp/voxel-world-error.log || exit 1
    check Error
    sleep 2
    for task_signal in TERM KILL; do
        task_log="/tmp/voxel-world-$task_signal.log"
        : > "$task_log"
        (
            wait_frame "$task_log"
            printf 'CPU online while running: %s\n' "$(cat /sys/devices/system/cpu/online)"
            kill "-$task_signal" "$(pidof trimui-voxel-world)"
        ) > "/tmp/voxel-world-$task_signal-helper.log" 2>&1 &
        task_helper_pid=$!
        sh ./test.sh --seconds 0 --save-dir "$task_save" --config-dir "$task_config" --seed 52 > "$task_log" 2>&1
        wait "$task_helper_pid" || exit 1
        cat "$task_log" "/tmp/voxel-world-$task_signal-helper.log"
        grep -q 'CPU online while running: 0-3' "/tmp/voxel-world-$task_signal-helper.log" || exit 1
        if [ "$task_signal" = TERM ]; then
            grep -q '^Voxel World exit status: 0' "$task_log" || exit 1
            grep -q 'World saved:' "$task_log" || exit 1
        else
            grep -q '^Voxel World exit status: 137' "$task_log" || exit 1
        fi
        check "$task_signal"
        sleep 2
    done
    # launch.sh is what MainUI runs; it must restore cores after a SIGKILL too.
    for task_ui_pid in $task_ui_pids; do kill -STOP "$task_ui_pid"; done
    trap 'for task_ui_pid in $task_ui_pids; do kill -CONT "$task_ui_pid"; done' EXIT
    task_log_size="$(wc -c < voxel-world.log 2>/dev/null || echo 0)"
    sh ./launch.sh --seconds 0 --save-dir "$task_save" --config-dir "$task_config" &
    task_launch_pid=$!
    task_attempt=0
    until tail -c "+$((task_log_size + 1))" voxel-world.log 2>/dev/null | grep -q 'First frame: present completed'; do
        task_attempt=$((task_attempt + 1))
        [ "$task_attempt" -lt 100 ] || exit 1
        sleep 0.1
    done
    sleep 1
    printf 'launch.sh CPU online while running: %s\n' "$(cat /sys/devices/system/cpu/online)"
    kill -KILL "$(pidof trimui-voxel-world)"
    wait "$task_launch_pid"
    for task_ui_pid in $task_ui_pids; do kill -CONT "$task_ui_pid"; done
    trap - EXIT
    check launch.sh-KILL
    sleep 2
    task_started="$(date +%s)"
    sh ./test.sh --seconds 0 --save-dir "$task_save" --config-dir "$task_config" > /tmp/voxel-world-timeout.log 2>&1
    task_elapsed=$(($(date +%s) - task_started))
    cat /tmp/voxel-world-timeout.log
    printf 'Watchdog elapsed: %s seconds\n' "$task_elapsed"
    [ "$task_elapsed" -ge 29 ] && [ "$task_elapsed" -le 37 ] || exit 1
    # This firmware's BusyBox may return the child's own status after TERM.
    grep -Eq '^Voxel World exit status: (0|124)' /tmp/voxel-world-timeout.log || exit 1
    grep -q 'World saved:' /tmp/voxel-world-timeout.log || exit 1
    check Watchdog
    printf '%s\n' 'Exit tests: PASS'
    EOF
    chmod 755 "{{ artifact_dir }}/device-input-test.sh" "{{ artifact_dir }}/device-exit-test.sh"

package profile="release": (stage profile)
    tar -czf "{{ artifact_root }}/voxel-world-trimui-smart-pro.tar.gz" -C "{{ artifact_root }}" Ports/VoxelWorld
    @printf 'Package: %s\n' "{{ artifact_root }}/voxel-world-trimui-smart-pro.tar.gz"

# Push the staged files without running anything; save/ and config/ stay untouched.
install profile="release": (package profile)
    #!/usr/bin/env bash
    set -euo pipefail
    adb wait-for-device
    task_guard="$(adb shell "if test ! -e '{{ device_dir }}' || test -f '{{ device_dir }}/{{ marker_name }}'; then printf DEPLOY_OK; else printf DEPLOY_REFUSED; fi")"
    case "$task_guard" in *DEPLOY_OK*) ;; *) printf 'Refusing to overwrite unmarked {{ device_dir }}\n' >&2; exit 1 ;; esac
    adb shell "mkdir -p '{{ device_dir }}'; touch '{{ device_dir }}/{{ marker_name }}'"
    for task_file in {{ binary_name }} launch.sh test.sh config.json icon.png {{ marker_name }}; do
        adb push "{{ stage_dir }}/$task_file" "{{ device_dir }}/$task_file" >/dev/null
    done
    adb shell "chmod 755 '{{ device_dir }}/{{ binary_name }}' '{{ device_dir }}/launch.sh' '{{ device_dir }}/test.sh'"
    task_local="$(sha256sum "{{ stage_dir }}/{{ binary_name }}" | cut -d' ' -f1)"
    task_remote="$(adb shell "sha256sum '{{ device_dir }}/{{ binary_name }}'" | cut -d' ' -f1)"
    [ "$task_local" = "$task_remote" ] || { printf 'Binary checksum mismatch\n' >&2; exit 1; }
    printf 'Installed: %s (%s)\n' "{{ device_dir }}" "${task_local:0:12}"

deploy profile="release": (install profile)
    #!/usr/bin/env bash
    set -euo pipefail
    task_cpu_before="$(adb shell cat /sys/devices/system/cpu/online | tr -d '\r')"
    adb shell rm -rf /tmp/voxel-world-smoke /tmp/voxel-world-smoke-config /tmp/voxel-world-setup.png
    set +e
    adb shell sh "{{ device_dir }}/test.sh" --seconds 15 --save-dir /tmp/voxel-world-smoke --config-dir /tmp/voxel-world-smoke-config --seed 42 --capture /tmp/voxel-world-setup.png | tee "{{ artifact_dir }}/deploy-test.log"
    set -e
    grep -q '^Voxel World exit status: 0' "{{ artifact_dir }}/deploy-test.log"
    grep -q 'First frame: present completed' "{{ artifact_dir }}/deploy-test.log"
    grep -q "CPU online after exit: $task_cpu_before" "{{ artifact_dir }}/deploy-test.log"
    adb pull /tmp/voxel-world-setup.png "{{ artifact_dir }}/setup.png" >/dev/null
    printf 'Smoke test: PASS (CPU online restored to %s)\n' "$task_cpu_before"

run *args:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ artifact_dir }}"
    task_args=( {{ args }} )
    if [ "${task_args[0]-}" = -- ]; then task_args=("${task_args[@]:1}"); fi
    task_save_args=(--save-dir /tmp/voxel-world-smoke --config-dir /tmp/voxel-world-smoke-config)
    task_capture=
    task_capture_next=false
    for task_arg in "${task_args[@]}"; do
        if "$task_capture_next"; then task_capture="$task_arg"; task_capture_next=false; fi
        case "$task_arg" in
            --save-dir|--save-dir=*|--config-dir|--config-dir=*) task_save_args=() ;;
            --capture) task_capture_next=true ;;
            --capture=*) task_capture="${task_arg#--capture=}" ;;
        esac
    done
    adb wait-for-device
    set +e
    adb shell sh "{{ device_dir }}/test.sh" "${task_save_args[@]}" "${task_args[@]}" | tee "{{ artifact_dir }}/run-adb.log"
    set -e
    grep -q '^Voxel World exit status: 0' "{{ artifact_dir }}/run-adb.log"
    case " ${task_args[*]} " in *" --probe "*) ;; *) grep -q 'First frame: present completed' "{{ artifact_dir }}/run-adb.log" ;; esac
    if [ -n "$task_capture" ]; then adb pull "$task_capture" "{{ artifact_dir }}/capture.png" >/dev/null; fi

# Scripted fly-through on the device; appends the result line to bench-history.log.
bench seconds="40" *args: install
    #!/usr/bin/env bash
    set -euo pipefail
    task_limit=$(( {{ seconds }} + 30 ))
    adb shell rm -f /tmp/voxel-world-bench.png
    set +e
    adb shell "VOXEL_TEST_LIMIT=$task_limit sh '{{ device_dir }}/test.sh' --bench {{ seconds }} --save-dir /tmp/voxel-world-bench --capture /tmp/voxel-world-bench.png --capture-after 15 {{ args }}" | tee "{{ artifact_dir }}/bench.log"
    set -e
    grep -q '^Voxel World exit status: 0' "{{ artifact_dir }}/bench.log"
    task_result="$(grep -o 'Bench result:.*' "{{ artifact_dir }}/bench.log" | tail -n 1)"
    [ -n "$task_result" ]
    adb pull /tmp/voxel-world-bench.png "{{ artifact_dir }}/bench.png" >/dev/null
    task_rev="$(git -C "{{ workspace_dir }}" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    printf '%s %s%s %s\n' "$(date -Iseconds)" "$task_rev" "$(git -C "{{ workspace_dir }}" diff --quiet 2>/dev/null || echo +dirty)" "$task_result" >> "{{ artifact_dir }}/bench-history.log"
    printf '%s\n' "$task_result"

input-test: deploy
    #!/usr/bin/env bash
    set -euo pipefail
    printf '%s\n' 'Input test writes event3: do not operate the physical controller during this test.'
    node "{{ artifact_dir }}/input-events.cjs" "{{ artifact_dir }}/input"
    adb shell rm -rf /tmp/voxel-world-input
    adb push "{{ artifact_dir }}/input" /tmp/voxel-world-input >/dev/null
    adb push "{{ artifact_dir }}/device-input-test.sh" /tmp/voxel-world-input-test.sh >/dev/null
    # Let MainUI finish reopening its audio route before pausing it again.
    sleep 2
    set +e
    adb shell sh /tmp/voxel-world-input-test.sh | tee "{{ artifact_dir }}/input-test.log"
    set -e
    grep -q '^Input test: PASS' "{{ artifact_dir }}/input-test.log"
    adb pull /tmp/voxel-world-game-1.png "{{ artifact_dir }}/palette.png" >/dev/null
    adb pull /tmp/voxel-world-game-2.png "{{ artifact_dir }}/controls.png" >/dev/null
    adb pull /tmp/voxel-world-game-3.png "{{ artifact_dir }}/game.png" >/dev/null

exit-test: install
    #!/usr/bin/env bash
    set -euo pipefail
    adb push "{{ artifact_dir }}/device-exit-test.sh" /tmp/voxel-world-exit-test.sh >/dev/null
    set +e
    adb shell sh /tmp/voxel-world-exit-test.sh | tee "{{ artifact_dir }}/exit-test.log"
    set -e
    grep -q '^Exit tests: PASS' "{{ artifact_dir }}/exit-test.log"

# Export the procedural texture sheet and icon atlas as PNG on the host.
atlas:
    cargo run --manifest-path "{{ workspace_dir }}/Cargo.toml" --locked -p {{ binary_name }} -- --dump-atlas "{{ artifact_dir }}/atlas"
    @printf 'Atlas: %s\n' "{{ artifact_dir }}/atlas"

# Export every synthesised sound as WAV on the host for listening.
sounds:
    rm -rf "{{ artifact_dir }}/sounds"
    cargo run --manifest-path "{{ workspace_dir }}/Cargo.toml" --locked -p {{ binary_name }} -- --dump-sounds "{{ artifact_dir }}/sounds"
    @printf 'Sounds: %s\n' "{{ artifact_dir }}/sounds"

clean:
    cargo clean --manifest-path "{{ workspace_dir }}/Cargo.toml" -p {{ binary_name }}
    rm -rf "{{ stage_dir }}" "{{ artifact_dir }}" "{{ artifact_root }}/voxel-world-trimui-smart-pro.tar.gz"
