set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

project_dir := source_directory()
workspace_dir := project_dir / "../.."
scripts := workspace_dir / "scripts"

default: package

fmt:
    bash "{{ scripts }}/cargo.sh" fmt voxel_world

test:
    bash "{{ scripts }}/cargo.sh" test voxel_world

clippy:
    bash "{{ scripts }}/cargo.sh" clippy voxel_world

check: fmt test clippy

build profile="release":
    bash "{{ scripts }}/cargo.sh" build voxel_world "$@"

stage profile="release": (build profile)
    bash "{{ scripts }}/stage.sh" voxel_world "$@"

package profile="release": (stage profile)
    bash "{{ scripts }}/package.sh" voxel_world

# Install the archive without starting the application.
deploy profile="release": (package profile)
    bash "{{ scripts }}/deploy.sh" voxel_world

# Deploy this module, then run its bounded device smoke test.
smoke-test profile="release": (deploy profile)
    bash "{{ scripts }}/smoke-test.sh" voxel_world

run *args:
    bash "{{ scripts }}/run.sh" voxel_world "$@"

input-test: smoke-test
    bash "{{ project_dir }}/scripts/input-test.sh"

# Compatibility entry point: deployment does not run a smoke test.
install profile="release": (deploy profile)

# Scripted fly-through; appends results to bench-history.log.
bench seconds="40" *args: deploy
    bash "{{ project_dir }}/scripts/bench.sh" "$@"

exit-test: deploy
    bash "{{ project_dir }}/scripts/exit-test.sh"

# Export the procedural texture sheet and icon atlas on the host.
atlas:
    cargo run --manifest-path "{{ workspace_dir }}/Cargo.toml" --locked -p trimui-voxel-world -- --dump-atlas "{{ workspace_dir }}/artifacts/voxel-world/atlas"
    @printf 'Atlas: %s\n' "{{ workspace_dir }}/artifacts/voxel-world/atlas"

# Export synthesised sounds as WAV on the host.
sounds:
    rm -rf "{{ workspace_dir }}/artifacts/voxel-world/sounds"
    cargo run --manifest-path "{{ workspace_dir }}/Cargo.toml" --locked -p trimui-voxel-world -- --dump-sounds "{{ workspace_dir }}/artifacts/voxel-world/sounds"
    @printf 'Sounds: %s\n' "{{ workspace_dir }}/artifacts/voxel-world/sounds"

clean:
    bash "{{ scripts }}/clean.sh" voxel_world
